{
	"name": "@isudev/gutenberg",
	"version": "0.1.1",
	"description": "Standalone components, controls, fields and hooks for the WordPress Gutenberg editor.",
	"keywords": [
		"wordpress",
		"gutenberg",
		"block-editor",
		"blocks",
		"block-development",
		"editor",
		"react",
		"components"
	],
	"homepage": "https://isudev-gutenberg-docs.isuke-priv.workers.dev",
	"bugs": {
		"url": "https://github.com/IsuDevelopment/gutenberg-components/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IsuDevelopment/gutenberg-components.git",
		"directory": "packages/gutenberg"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"bin",
		"src/**/README.md",
		"AGENTS.md",
		"catalog.json",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"isudev-gutenberg": "./bin/isudev-gutenberg.mjs"
	},
	"exports": {
		"./catalog.json": "./catalog.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./appenders": {
			"types": "./dist/appenders/index.d.ts",
			"import": "./dist/appenders/index.js"
		},
		"./breakpoints": {
			"types": "./dist/breakpoints/index.d.ts",
			"import": "./dist/breakpoints/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"import": "./dist/components/index.js"
		},
		"./components/*": {
			"types": "./dist/components/*/index.d.ts",
			"import": "./dist/components/*/index.js"
		},
		"./controls": {
			"types": "./dist/controls/index.d.ts",
			"import": "./dist/controls/index.js"
		},
		"./controls/*": {
			"types": "./dist/controls/*/index.d.ts",
			"import": "./dist/controls/*/index.js"
		},
		"./fields": {
			"types": "./dist/fields/index.d.ts",
			"import": "./dist/fields/index.js"
		},
		"./fields/*": {
			"types": "./dist/fields/*/index.d.ts",
			"import": "./dist/fields/*/index.js"
		},
		"./meta": {
			"types": "./dist/meta/index.d.ts",
			"import": "./dist/meta/index.js"
		},
		"./meta/*": {
			"types": "./dist/meta/*/index.d.ts",
			"import": "./dist/meta/*/index.js"
		},
		"./taxonomy": {
			"types": "./dist/taxonomy/index.d.ts",
			"import": "./dist/taxonomy/index.js"
		},
		"./taxonomy/*": {
			"types": "./dist/taxonomy/*/index.d.ts",
			"import": "./dist/taxonomy/*/index.js"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"import": "./dist/hooks/index.js"
		},
		"./hooks/*": {
			"types": "./dist/hooks/*/index.d.ts",
			"import": "./dist/hooks/*/index.js"
		},
		"./bindings": {
			"types": "./dist/bindings/index.d.ts",
			"import": "./dist/bindings/index.js"
		}
	},
	"scripts": {
		"catalog": "node scripts/catalog.ts",
		"prepack": "npm run build",
		"build": "npm run catalog && tsup && tsc -p tsconfig.build.json",
		"dev": "tsup --watch",
		"clean": "rm -rf dist .turbo node_modules",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "jest",
		"test:watch": "jest --watch",
		"smoke:package": "node scripts/smoke-package.ts",
		"verify:package": "npm run build && publint --strict && attw --pack . --profile esm-only && npm run smoke:package"
	},
	"peerDependencies": {
		"@wordpress/block-editor": ">=15.0.0",
		"@wordpress/components": ">=32.0.0",
		"@wordpress/core-data": ">=7.0.0",
		"@wordpress/data": ">=10.0.0",
		"@wordpress/editor": ">=14.0.0",
		"@wordpress/element": ">=6.0.0",
		"@wordpress/i18n": ">=6.0.0",
		"@wordpress/icons": ">=11.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@swc/core": "^1.7.0",
		"@swc/jest": "^0.2.39",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/react": "^16.0.1",
		"@testing-library/user-event": "^14.5.2",
		"@types/jest": "^29.5.14",
		"@types/react": "^18.3.27",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"publint": "^0.3.22",
		"@wordpress/block-editor": "15.13.2",
		"@wordpress/components": "32.2.1",
		"@wordpress/core-data": "7.40.2",
		"@wordpress/data": "10.40.1",
		"@wordpress/editor": "14.40.2",
		"@wordpress/element": "6.40.1",
		"@wordpress/i18n": "6.13.1",
		"@wordpress/icons": "11.7.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tsup": "^8.3.0",
		"typescript": "^5.6.0"
	}
}
