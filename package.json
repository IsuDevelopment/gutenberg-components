{
	"name": "isudev-gutenberg-monorepo",
	"private": true,
	"description": "Monorepo for @isudev/gutenberg and its example blocks.",
	"engines": {
		"node": "20",
		"npm": ">=10"
	},
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"dev": "npm run dev --workspace=packages/gutenberg",
		"build": "npm run build --workspace=packages/gutenberg",
		"build:example": "npm run build --workspace=examples/test-blocks",
		"start:example": "npm run start --workspace=examples/test-blocks",
		"test": "npm run test --workspace=packages/gutenberg"
	}
}
